---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SiteHead from '../../components/SiteHead.astro';
import { collections } from '../../data/collections';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead />

    <title>Collection | ECHO</title>

    <meta
      name="description"
      content="Explore ECHO's audio collections, from AEROSPACE and LUMIA to STARLIGHT, VENUS, VESPER, MONO and SPHERE."
    />
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <Navbar />

    <main id="main" class="collections-page-main">
      <div class="container-fluid echo-container">
        <nav aria-label="Breadcrumb" class="mb-4">
          <ol class="breadcrumb cart-breadcrumb">
            <li class="breadcrumb-item">
              <a href={`${base}/`}>Home</a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
              Collection
            </li>
          </ol>
        </nav>

        <h1 class="editorial-heading collections-page-title">
          collection
          <span class="heading-line" aria-hidden="true"></span>
          <span class="diamond" aria-hidden="true"></span>
        </h1>

        <div class="collections-grid">
          {collections.map((collection) => (
            <a
              class="collection-card"
              href={`${base}/collections/${collection.slug}/`}
            >
              <img
                class="collection-card-cover"
                src={`${base}${collection.cover}`}
                alt=""
                loading="lazy"
                decoding="async"
              />

              <h2
                class:list={[
                  'collection-card-title',
                  `collection-font--${collection.slug}`,
                ]}
              >
                {collection.name}
              </h2>
            </a>
          ))}
        </div>
      </div>
    </main>

    <Footer />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
    ></script>
  </body>
</html>