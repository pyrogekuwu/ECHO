---
import { getCollection } from 'astro:content';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

const posts = (await getCollection('magazine')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">

    <head>
        <SiteHead />
        <title>magazine | ECHO</title>
    </head>

    <body id="top" class="magazine-page">

        <Navbar />

        <main id="main" class="category-main py-5">
            <div class="container">

            <h1>magazine</h1>

            <div class="row g-4">
                
                {posts.map((post) => (
                <div class="col-12 col-md-6 col-lg-4">
                    
                    <article>
                        <a href={`${base}/magazine/${post.id}/`} class="d-block">
                            <img
                            src={`${base}${post.data.image}`} 
                            alt={post.data.imageAlt} 
                            class="magazine-image mb-3" 
                            loading="lazy"/>
                        </a>

                        <p class="small text-uppercase mb-2">{post.data.category}</p>

                        <time class="d-block small mb-2" datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',})}
                            </time>
                            
                            <h2 class="h4">
                                <a href={`${base}/magazine/${post.id}/`} class="text-decoration-none">
                                    {post.data.title}
                                </a>
                            </h2>

                            <p>{post.data.description}</p>

                            <a href={`${base}/magazine/${post.id}/`} class="rectangle-button button-dark article-read-more">
                                read more<span aria-hidden="true">❯</span>
                            </a>

                    </article>
                </div>
                ))}
            </div>
            </div>
        </main>

        <Footer />

        <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

    </body>
</html>