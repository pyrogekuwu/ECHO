---
import { getCollection } from 'astro:content';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const posts = (await getCollection('magazine')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="ECHO magazine - the story behind our products" />

        <title>magazine | ECHO</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DotGothic16&family=Genos:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link href={`${base}/style.css`} rel="stylesheet" />
    </head>

    <body id="top" class="magazine-page">

        <Navbar />

        <main id="main" class="category-main py-5">
            <div class="container">

            <h1>magazine</h1>

            <div class="row g-4">
                
                {posts.map((post) => (
                <div class="col-12 col-md-6 col-lg-4">
                    
                    <article>
                        <a href={`${base}/magazine/${post.id}/`} class="d-block">
                            <img
                            src={`${base}${post.data.image}`} 
                            alt={post.data.imageAlt} 
                            class="magazine-image mb-3" 
                            loading="lazy"/>
                        </a>

                        <p class="small text-uppercase mb-2">{post.data.category}</p>

                        <time class="d-block small mb-2" datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',})}
                            </time>
                            
                            <h2 class="h4">
                                <a href={`${base}/magazine/${post.id}/`} class="text-decoration-none">
                                    {post.data.title}
                                </a>
                            </h2>

                            <p>{post.data.description}</p>

                            <a href={`${base}/magazine/${post.id}/`} class="rectangle-button button-dark article-read-more">
                                read more<span aria-hidden="true">❯</span>
                            </a>

                    </article>
                </div>
                ))}
            </div>
            </div>
        </main>

        <Footer />

        <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

    </body>
</html>