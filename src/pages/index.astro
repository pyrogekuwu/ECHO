---
const year = new Date().getFullYear();
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "ECHO",
  description: "Experimental audio brand — headphones, earbuds, speakers and everyday audio accessories.",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="discover ECHO - expressive audio devices, considered design and a new perspective on everyday listening." />
    <meta name="theme-color" content="#080A29" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ECHO" />
    <meta property="og:description" content="Headphones, earbuds and speakers with a different point of view." />
    <!-- Dla publikacji zastąp względny adres absolutnym URL własnej domeny. -->
    <meta property="og:image" content="/images/echo-header-light.png" />
    <title>ECHO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5: arkusz frameworka najpierw, własne style po nim. -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="/style.css" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body id="top">
    <a class="echo-skip-link" href="#main">Skip to content</a>

    <header class="echo-site-header">
      <nav class="navbar navbar-expand-lg echo-navbar" aria-label="Main navigation">
        <div class="container echo-container">
          <a class="navbar-brand echo-wordmark" href="#top" aria-label="ECHO homepage">echo<span aria-hidden="true">.</span></a>
          <button class="navbar-toggler echo-navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#echo-navigation" aria-controls="echo-navigation" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="echo-navigation">
            <ul class="navbar-nav ms-auto align-items-lg-center echo-nav-list">
              <li class="nav-item"><a class="nav-link echo-nav-link" href="#o-nas">our world</a></li>
              <li class="nav-item"><a class="nav-link echo-nav-link" href="#oferta">collection</a></li>
              <li class="nav-item"><a class="nav-link echo-nav-link" href="#kontakt">contact</a></li>
            </ul>
            <a class="echo-nav-cta" href="#kontakt">Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </nav>
    </header>

    <main id="main">
      <!-- Hero: full-width artwork by the ECHO designer, kept unchanged. -->
      <section class="echo-hero" aria-labelledby="hero-title">
        <div class="echo-hero-artwork">
          <img
            src="/images/echo-header-light.png"
            alt="Sculptural pearl-white futuristic over-ear headphones surrounded by flowing pastel-pink light trails"
            width="2048"
            height="857"
            fetchpriority="high"
          />
        </div>
        <div class="container echo-container echo-hero-container">
          <div class="row align-items-center echo-hero-grid">
            <div class="col-12 col-lg-6 col-xl-5 echo-hero-copy">
              <p class="echo-kicker"><span class="echo-kicker-dot" aria-hidden="true"></span> A NEW FREQUENCY OF DESIGN</p>
              <h1 id="hero-title">Sound, <em>reimagined.</em></h1>
              <p class="echo-hero-lead">Unexpected forms. Immersive sound. Meet audio made to feel as distinctive as your world.</p>
              <div class="d-flex flex-wrap gap-3 align-items-center echo-hero-actions">
                <a class="btn echo-btn echo-btn-primary" href="#o-nas">Discover ECHO <span aria-hidden="true">↗</span></a>
                <a class="echo-text-link" href="#oferta">Explore the collection <span aria-hidden="true">→</span></a>
              </div>
              <div class="echo-hero-caption"><span class="echo-mini-line" aria-hidden="true"></span> DESIGN-LED AUDIO / EST. 2026</div>
            </div>
          </div>
        </div>
      </section>

      <div class="echo-signal-bar" aria-label="ECHO design principles">
      </div>

      <section id="o-nas" class="echo-section echo-about" aria-labelledby="about-title">
        <div class="container echo-container">
          <div class="row align-items-center gy-5 gx-lg-5">
            <div class="col-12 col-lg-6">
              <div class="echo-about-art">
                
                <span class="echo-art-note">FORM / FREQUENCY / FEELING</span>
              </div>
            </div>
            <div class="col-12 col-lg-6">
              <p class="echo-section-label">01 / ABOUT ECHO</p>
              <h2 id="about-title" class="echo-section-heading">Made for the way <em>you listen.</em></h2>
              <p class="echo-paragraph">ECHO explores the space between sound, technology and self-expression. We create audio essentials with considered details and a distinct visual language.</p>
              <p class="echo-paragraph">Our world is playful and a little unreal — but our approach to everyday audio is simple: feel immersed, stay curious, and make listening your own.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="oferta" class="echo-section echo-collection" aria-labelledby="collection-title">
        <div class="container echo-container">
          <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 echo-section-intro">
            <div>
              <p class="echo-section-label">02 / THE COLLECTION</p>
              <h2 id="collection-title" class="echo-section-heading">Find your <em>frequency.</em></h2>
            </div>
            <p class="echo-intro-note">Three ways to make sound your own. More to come.</p>
          </div>
          <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4">
              <article class="card echo-category-card h-100">
                <div class="echo-category-visual echo-category-headphones">
                  <span class="echo-category-index">01 / LISTEN</span>
                  <svg viewBox="0 0 320 250" class="echo-product-sketch" role="img" aria-label="Stylized illustration of over-ear headphones" xmlns="http://www.w3.org/2000/svg">
                    <defs><linearGradient id="hShell" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ffffff"/><stop offset="1" stop-color="#A3B7F0"/></linearGradient></defs>
                    <path d="M82 160v-42a78 78 0 0 1 156 0v42" fill="none" stroke="#22274F" stroke-width="23" stroke-linecap="round"/>
                    <path d="M82 147v-30a78 78 0 0 1 156 0v30" fill="none" stroke="#EDF1FF" stroke-width="11" stroke-linecap="round"/>
                    <rect x="61" y="139" width="47" height="75" rx="22" fill="url(#hShell)" stroke="#A8ADCB" stroke-width="2" transform="rotate(7 84 176)"/>
                    <rect x="212" y="139" width="47" height="75" rx="22" fill="url(#hShell)" stroke="#A8ADCB" stroke-width="2" transform="rotate(-7 236 176)"/>
                    <rect x="78" y="158" width="11" height="33" rx="6" fill="#6F6A95" opacity=".4"/>
                    <rect x="231" y="158" width="11" height="33" rx="6" fill="#6F6A95" opacity=".4"/>
                  </svg>
                </div>
                <div class="card-body echo-category-body">
                  <div><h3>Headphones</h3><p>Comfort, character and sound that stays with you.</p></div>
                  <a class="echo-card-footnote" href="#kontakt" aria-label="Ask about ECHO headphones">ASK ABOUT HEADPHONES <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
              <article class="card echo-category-card h-100">
                <div class="echo-category-visual echo-category-earbuds">
                  <span class="echo-category-index">02 / MOVE</span>
                  <svg viewBox="0 0 320 250" class="echo-product-sketch" role="img" aria-label="Stylized illustration of wireless earbuds" xmlns="http://www.w3.org/2000/svg">
                    <defs><linearGradient id="eShell" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff"/><stop offset="1" stop-color="#B8A9F1"/></linearGradient></defs>
                    <g transform="rotate(-16 114 130)"><rect x="96" y="70" width="49" height="71" rx="25" fill="url(#eShell)" stroke="#A8A2CA" stroke-width="2"/><rect x="114" y="128" width="18" height="77" rx="9" fill="url(#eShell)" stroke="#A8A2CA" stroke-width="1.5"/><circle cx="120" cy="95" r="6" fill="#6863A1" opacity=".8"/></g>
                    <g transform="rotate(16 207 125)"><rect x="177" y="67" width="49" height="71" rx="25" fill="url(#eShell)" stroke="#A8A2CA" stroke-width="2"/><rect x="189" y="124" width="18" height="77" rx="9" fill="url(#eShell)" stroke="#A8A2CA" stroke-width="1.5"/><circle cx="201" cy="92" r="6" fill="#6863A1" opacity=".8"/></g>
                  </svg>
                </div>
                <div class="card-body echo-category-body">
                  <div><h3>Earbuds</h3><p>Compact essentials for every soundtrack and every day.</p></div>
                  <a class="echo-card-footnote" href="#kontakt" aria-label="Ask about ECHO earbuds">ASK ABOUT EARBUDS <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
              <article class="card echo-category-card h-100">
                <div class="echo-category-visual echo-category-speakers">
                  <span class="echo-category-index">03 / SHARE</span>
                  <svg viewBox="0 0 320 250" class="echo-product-sketch" role="img" aria-label="Stylized illustration of a portable mini speaker" xmlns="http://www.w3.org/2000/svg">
                    <defs><linearGradient id="sShell" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff"/><stop offset="1" stop-color="#C3D6F1"/></linearGradient></defs>
                    <rect x="72" y="65" width="176" height="144" rx="42" fill="url(#sShell)" stroke="#A5B7CD" stroke-width="2"/>
                    <circle cx="160" cy="137" r="54" fill="#394167"/><circle cx="160" cy="137" r="43" fill="#848CB5"/><circle cx="160" cy="137" r="29" fill="#343B61"/><circle cx="160" cy="137" r="12" fill="#9EA5D4"/>
                    <circle cx="202" cy="85" r="4" fill="#5826C7"/>
                  </svg>
                </div>
                <div class="card-body echo-category-body">
                  <div><h3>Mini speakers</h3><p>Small forms. Room-filling energy. Sound to share.</p></div>
                  <a class="echo-card-footnote" href="#kontakt" aria-label="Ask about ECHO mini speakers">ASK ABOUT SPEAKERS <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            </div>
          </div>
          <div class="echo-accessories-note"><span>AND THE LITTLE THINGS</span> Protective cases, charging docks, stands, ear tips and carry accessories.</div>
        </div>
      </section>

      <section id="kontakt" class="echo-section echo-contact" aria-labelledby="contact-title">
        <div class="container echo-container">
          <div class="row gx-lg-5 gy-5 align-items-start">
            <div class="col-12 col-lg-5">
              <p class="echo-section-label echo-section-label-light">03 / CONTACT</p>
              <h2 id="contact-title" class="echo-section-heading echo-contact-heading">Let's make <em>some noise.</em></h2>
              <p class="echo-contact-copy">Questions about ECHO, our collection or a future collaboration? Drop us a message.</p>
              <dl class="echo-contact-details">
                <div><dt>Email</dt><dd>hello@echo.example <small>(demo)</small></dd></div>
                <div><dt>Phone</dt><dd>+48 000 000 000 <small>(demo)</small></dd></div>
                <div><dt>Location</dt><dd>Poland · fictional brand</dd></div>
              </dl>
            </div>
            <div class="col-12 col-lg-7">
              <form id="echo-contact-form" class="echo-contact-form">
                <div class="row g-3">
                  <div class="col-12 col-md-6">
                    <label for="echo-name" class="form-label">Your name *</label>
                    <input class="form-control echo-form-control" type="text" id="echo-name" name="name" autocomplete="name" placeholder="Full name" required />
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="echo-email" class="form-label">Email address *</label>
                    <input class="form-control echo-form-control" type="email" id="echo-email" name="email" autocomplete="email" placeholder="you@example.com" required />
                  </div>
                  <div class="col-12">
                    <label for="echo-subject" class="form-label">What's this about? *</label>
                    <select class="form-select echo-form-control" id="echo-subject" name="subject" required>
                      <option value="" selected disabled>Choose a topic</option>
                      <option value="products">Products & availability</option>
                      <option value="accessories">Accessories</option>
                      <option value="collaboration">Collaborations</option>
                      <option value="other">Something else</option>
                    </select>
                  </div>
                  <div class="col-12">
                    <label for="echo-message" class="form-label">Your message *</label>
                    <textarea class="form-control echo-form-control" id="echo-message" name="message" rows="5" placeholder="Tell us what's on your mind..." required></textarea>
                  </div>
                  <div class="col-12 d-flex flex-column gap-3 align-items-start">
                    <button class="btn echo-btn echo-btn-secondary" type="submit">Send message <span aria-hidden="true">↗</span></button>
                    <p class="echo-form-disclaimer">Demo form — messages are not sent yet.</p>
                    <p id="echo-form-status" class="echo-form-status" role="status" hidden>This is a design preview. Your message has not been sent.</p>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="echo-footer">
      <div class="container echo-container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <a href="#top" class="echo-wordmark echo-footer-logo" aria-label="ECHO — back to top">echo<span aria-hidden="true">.</span></a>
        <span>© {year} ECHO. Concept brand for a university project.</span>
        <a href="#top" class="echo-back-to-top">Back to top ↑</a>
      </div>
    </footer>

    
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js" defer></script>

    <script>
      const form = document.querySelector<HTMLFormElement>("#echo-contact-form");
      const status = document.querySelector<HTMLElement>("#echo-form-status");
      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        if (status) status.hidden = false;
      });
    </script>
  </body>
</html>
