---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';
import { products } from '../data/products';
import ProductCard from '../components/ProductCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* ECHO landing page */
const categories = [
  { name: 'headphones', image: '/images/category-headphones.png', alt: 'Metallic over-ear ECHO headphones on a black background', href: `${base}/headphones/` },
  { name: 'earbuds', image: '/images/category-earbuds.png', alt: 'Chrome star-shaped Aerospace wireless earbuds', href: `${base}/earbuds/` },
  { name: 'speakers', image: '/images/category-speakers.png', alt: 'Dark grey compact speaker with sculptural driver', href: `${base}/speakers/` },
  { name: 'accessories', image: '/images/category-accessories.png', alt: 'Metallic silver audio accessories and charms', href: `${base}/accessories/` },
];
const bestsellerIds = [
  'product-lumia-white',
  'product-aerospace-silver',
  'product-venus-silver',
];

const bestsellers = bestsellerIds.map((id) => {
  const product = products.find((item) => item.id === id);
  if (!product) {
    throw new Error(`Nie znaleziono produktu bestsellera: ${id}`);
  }
  return product;
});

const priceFormatter = new Intl.NumberFormat('en-IE', {
  style: 'currency',
  currency: 'EUR',
});

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ECHO',
  description: 'Fictional South Korean audio brand, developed as a university design project.',
};
---


<!doctype html>
<html lang="en">

  <head>
    <SiteHead />
    <title>ECHO</title>
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>



    <Navbar />



    <main id="main">
    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-stage">
        <div class="hero-photo" aria-hidden="true"></div>

        <div class="hero-content container-fluid">
          <div class="hero-copy">
            <p class="hero-meta">NEW ITEM <span>|</span> NEW EXPERIENCE <span>|</span> NEW SOUND</p>
            <h1 id="hero-heading">LUMIA PRO 2</h1>
            <p class="hero-description">Over-ear headphones with a sculptural silhouette and a sharp, metallic finish. Lumia Pro 2 takes a familiar form and shifts it into something more distinctive.</p>
            <p class="hero-description hero-material">ON ANOTHER FREQUENCY.</p>
            <a class="rectangle-button button-light hero-discover" href={`${base}/magazine/lumia-pro-2/`}>discover</a>
          </div>
        </div>
      </div>
    </section>

      <div class="homepage-catalog-background">


        <!-- SHOP BY CATEGORIES -->
        <section id="shop" class="shop-categories content-section" aria-labelledby="categories-heading">
          <div class="container-fluid echo-container">
            <h2 id="categories-heading" class="editorial-heading">shop by categories <span class="heading-line" aria-hidden="true">
              </span><span class="diamond" aria-hidden="true"></span>
            </h2>

            <div class="row g-3 g-xl-4 category-row">
              {categories.map((category) => (
                <div class="col-6 col-lg-3" id={`category-${category.name}`}>
                  <a class="category-tile" href={category.href} aria-label={`Explore ${category.name}`}>
                    <div class="category-image"><img src={`${base}${category.image}`} alt={category.alt} loading="lazy" /></div>
                    <span class="category-label">{category.name}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8"/></svg>
                    </span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- SHOP BY COLLECTIONS -->
         <section id="collections" class="collections-section content-section" aria-labelledby="collections-heading">
  
          <div class="container-fluid echo-container">
            <div class="collection-topline">
      
              <h2 id="collections-heading" class="editorial-heading">
                shop by collections
                <span class="heading-line" aria-hidden="true"></span>
                <span class="diamond" aria-hidden="true"></span>
              </h2>

              <a class="rectangle-button button-dark collection-more" href="#bestsellers">
                find more to like
                <span aria-hidden="true">❯</span>
              </a>
            </div>

    
            <div class="aerospace-editorial">
              <h3>
                <a href="#product-aerospace-black" class="aerospace-link">AEROSPACE</a>
              </h3>
      
              <div class="editorial-detail">
                <span class="korean-label" lang="ko">다른주파수에서</span>

                <a href="#product-aerospace-black" aria-label="View Aerospace earbuds">
                <img src={`${base}/images/aerospace-detail.png`} 
                alt="Close-up of a metallic silver Aerospace earbud worn on an ear" loading="lazy"/>
              </a>
            </div>
    
            <div class="editorial-portrait">
              <a href="#product-aerospace-black" aria-label="View Aerospace earbuds">
              <img src={`${base}/images/aerospace-portrait.png`} alt="Profile of a model wearing a chrome Aerospace earbud" loading="lazy"/>
            </a>
          </div>
      
          <div class="editorial-copy">
            <p>
              Aerospace is ECHO's more experimental take on wireless earbuds.
              Defined by sharp silhouettes, the collection draws inspiration
              from early-2000s cyber aesthetics and jewelry design.
              Familiar technology <b>NOT MADE TO BLEND IN.</b>
            </p>

            <p>
              While most earbuds are designed to go unnoticed, Aerospace takes
              the opposite approach. The collection explores what happens when
              technology becomes part of personal style.
            </p>
          </div>
        </div>
      </div>
    </section> 
  </div>


      <!-- ABOUT OUR WORLD -->
      <section id="about" class="about-section" aria-labelledby="about-heading">
        <div class="container-fluid echo-container about-inner">
          <img class="about-star about-star-left" src={`${base}/images/about-star-left.png`} alt="" loading="eager" />
          <div class="about-copy">
            <h2 id="about-heading">ABOUT OUR WORLD</h2>
            <p>ECHO is a concept audio brand based in South Korea.</p>
            <p>We are exploring the relationship between innovative product design and everyday listening with style. We focus on form, color and the small details that make objects feel personal. Our collection brings together headphones, wireless earbuds, compact speakers and the accessories that go with them.</p>
            <p>A space to experiment with what consumer audio could look like.</p>
            <a class="rectangle-button button-light about-contact" href={`${base}/contact/`}>get in contact</a>
          </div>
          <img class="about-star about-star-right" src={`${base}/images/about-star-right.png`} alt="" loading="eager" />
        </div>
      </section>


      <!-- BESTSELLERS -->
       <section
       id="bestsellers"
      class="bestsellers-section content-section"
      aria-labelledby="bestsellers-heading"
      >
      
        <div class="container-fluid echo-container">
          <h2 id="bestsellers-heading" class="editorial-heading">
            our bestsellers
            <span class="heading-line" aria-hidden="true"></span>
            <span class="diamond" aria-hidden="true"></span>
          </h2>

        <div class="row g-3 g-xl-5 bestseller-row">
          {bestsellers.map((product) => (
            <div class="col-12 col-sm-6 col-lg-4">
              <ProductCard product={product} showRating featured />
            </div>
          ))}
        </div>
        </div>
      </section>
</main>

    <Footer />

    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script> 
   
  </body>
</html>
