---
import Navbar from '../components/Navbar.astro';

/**
 * ECHO landing page
 */
const year = new Date().getFullYear();
const categories = [
  { name: 'headphones', image: '/images/category-headphones.png', alt: 'Metallic over-ear ECHO headphones on a black background', href: '#product-lumia-white' },
  { name: 'earbuds', image: '/images/category-earbuds.png', alt: 'Chrome star-shaped Aerospace wireless earbuds', href: '#product-aerospace-black' },
  { name: 'speakers', image: '/images/category-speakers.png', alt: 'Dark grey compact speaker with sculptural driver', href: '#contact' },
  { name: 'accessories', image: '/images/category-accessories.png', alt: 'Metallic silver audio accessories and charms', href: '#contact' },
];
const bestsellers = [
  { id: 'product-lumia-white', name: 'LUMIA Pro 2 White', price: '€139.99', image: '/images/product-lumia-white.png', alt: 'White sculptural Lumia Pro 2 wireless headphones' },
  { id: 'product-aerospace-black', name: 'AEROSPACE Earbuds Black', price: '€79.99', image: '/images/product-aerospace-black.png', alt: 'Pair of black Aerospace earbuds with metallic silver star shapes' },
  { id: 'product-vesper-silver', name: 'VESPER Metallic Silver', price: '€99.99', image: '/images/product-vesper-silver.png', alt: 'Silver and black over-ear headphones shown on a white background' },
];
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ECHO',
  description: 'Fictional South Korean audio brand, developed as a university design project.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050507" />
    <meta name="description" content="Explore ECHO: Lumia Pro 2 headphones, Aerospace earbuds, speakers and accessories. An experimental audio brand concept." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ECHO" />
    <meta property="og:description" content="Headphones, earbuds, speakers and accessories. ECHO audio brand concept." />
    <meta property="og:image" content="/images/hero-lumia.png" />
    <title>ECHO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DotGothic16&family=Genos:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/style.css" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>



    <Navbar />



    <main id="main">
    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-stage">
        <div class="hero-photo" aria-hidden="true"></div>

        <div class="hero-content container-fluid">
          <div class="hero-copy">
            <p class="hero-meta">NEW ITEM <span>|</span> NEW EXPERIENCE <span>|</span> NEW SOUND</p>
            <h1 id="hero-heading">LUMIA PRO 2</h1>
            <p class="hero-description">Over-ear headphones with a sculptural silhouette and a sharp, metallic finish. Lumia Pro 2 takes a familiar form and shifts it into something more distinctive.</p>
            <p class="hero-description hero-material">ON ANOTHER FREQUENCY.</p>
            <a class="rectangle-button button-light hero-discover" href="#product-lumia-white">discover</a>
          </div>
        </div>
      </div>
    </section>

      <div class="homepage-catalog-background">
        <!-- SHOP BY CATEGORIES -->
        <section id="shop" class="shop-categories content-section" aria-labelledby="categories-heading">
          <div class="container-fluid echo-container">
            <h2 id="categories-heading" class="editorial-heading">shop by categories <span class="heading-line" aria-hidden="true"></span><span class="diamond" aria-hidden="true"></span></h2>
            <div class="row g-3 g-xl-4 category-row">
              {categories.map((category) => (
                <div class="col-6 col-lg-3">
                  <a class="category-tile" href={category.href} aria-label={`Explore ${category.name}`}>
                    <div class="category-image"><img src={category.image} alt={category.alt} loading="lazy" /></div>
                    <span class="category-label">{category.name}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8"/></svg>
                    </span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- SHOP BY COLLECTIONS -->
        <section id="collections" class="collections-section content-section" aria-labelledby="collections-heading">
          <div class="container-fluid echo-container">
            <div class="collection-topline">
              <h2 id="collections-heading" class="editorial-heading">shop by collections <span class="heading-line" aria-hidden="true"></span><span class="diamond" aria-hidden="true"></span></h2>
              <a class="rectangle-button button-dark collection-more" href="#bestsellers">find more to like <span aria-hidden="true">❯</span></a>
            </div>
            <div class="aerospace-editorial">
              <h3><a href="#product-aerospace-black" class="aerospace-link">AEROSPACE</a></h3>
              <div class="editorial-detail">
                <span class="korean-label">다른주파수에서</span>
                <a href="#product-aerospace-black" aria-label="View Aerospace earbuds">
                  <img src="/images/aerospace-detail.png" alt="Close-up of a metallic silver Aerospace earbud worn on an ear" loading="lazy" /></a>
              </div>
              <div class="editorial-portrait">
                <a href="#product-aerospace-black" aria-label="View Aerospace earbuds">
                  <img src="/images/aerospace-portrait.png" alt="Profile of a model wearing a chrome Aerospace earbud" loading="lazy" /></a>
                <img src="/images/aerospace-portrait.png" alt="Profile of a model wearing a chrome Aerospace earbud" loading="lazy" /></div>
              <div class="editorial-copy">
                <p>Aerospace is ECHO's more experimental take on wireless earbuds. Defined by sharp silhouettes, 
                  the collection draws inspiration from early-2000s cyber aesthetics and jewelry design. 
                  Familiar technology <b>NOT MADE TO BLEND IN.</b></p>
                <p>While most earbuds are designed to go unnoticed, Aerospace takes the opposite approach. 
                  The collection explores what happens when technology becomes part of personal style.</p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- ABOUT OUR WORLD -->
      <section id="about" class="about-section" aria-labelledby="about-heading">
        <div class="container-fluid echo-container about-inner">
          <img class="about-star about-star-left" src="/images/about-star-left.png" alt="" loading="eager" />
          <div class="about-copy">
            <h2 id="about-heading">ABOUT OUR WORLD</h2>
            <p>ECHO is a concept audio brand based in South Korea.</p>
            <p>We are exploring the relationship between innovative product design and everyday listening with style. We focus on form, color and the small details that make objects feel personal. Our collection brings together headphones, wireless earbuds, compact speakers and the accessories that go with them.</p>
            <p>Designed as a university project, ECHO is a space to experiment with what consumer audio could look like.</p>
            <a class="rectangle-button button-light about-contact" href="#contact">get in contact</a>
          </div>
          <img class="about-star about-star-right" src="/images/about-star-right.png" alt="" loading="eager" />
        </div>
      </section>

      <!-- BESTSELLERS -->
      <section id="bestsellers" class="bestsellers-section content-section" aria-labelledby="bestsellers-heading">
        <div class="container-fluid echo-container">
          <h2 id="bestsellers-heading" class="editorial-heading">our bestsellers <span class="heading-line" aria-hidden="true"></span><span class="diamond" aria-hidden="true"></span></h2>
          <div class="row g-3 g-xl-5 bestseller-row">
            {bestsellers.map((product) => (
              <div class="col-12 col-sm-6 col-lg-4">
                <article class="bestseller" id={product.id}>
                  <a href="/shop" class="bestseller-link">
                  <div class="bestseller-photo">
                    <img src={product.image} alt={product.alt} loading="lazy"/>
                  </div>
                  <h3>{product.name}</h3>
                  <p class="price">{product.price}</p>
                  </a>
                </article>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="contact-section" aria-labelledby="contact-heading">
        <div class="container-fluid echo-container">
          <div class="row gx-5 gy-5 align-items-start">
            <div class="col-12 col-lg-5 contact-info">
              <h2 id="contact-heading">GET IN CONTACT</h2>
              <p class="contact-intro">Questions about the collection or the ECHO concept? Send us a note.</p>
              <dl class="contact-details">
                <div><dt>EMAIL</dt><dd>contact@echo.com</dd></div>
                <div><dt>PHONE</dt><dd>+00 000-0000</dd></div>
                <div><dt>BASED IN</dt><dd>South Korea, Seoul</dd></div>
              </dl>
            </div>
            <div class="col-12 col-lg-6 offset-lg-1">
              <form id="contact-form" class="contact-form">
                <div class="row g-3">
                  <div class="col-12 col-sm-6">
                    <label for="contact-name" class="form-label">Name *</label>
                    <input class="form-control" id="contact-name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
                  </div>
                  <div class="col-12 col-sm-6">
                    <label for="contact-email" class="form-label">E-mail *</label>
                    <input class="form-control" id="contact-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
                  </div>
                  <div class="col-12">
                    <label for="contact-subject" class="form-label">Subject *</label>
                    <select class="form-select" name="subject" id="contact-subject" required>
                      <option value="" disabled selected>Select subject</option>
                      <option value="products">Products / collection</option>
                      <option value="collaboration">Collaboration</option>
                      <option value="press">Press / media</option>
                      <option value="other">Something else</option>
                    </select>
                  </div>
                  <div class="col-12">
                    <label for="contact-message" class="form-label">Message *</label>
                    <textarea class="form-control" name="message" id="contact-message" rows="5" placeholder="Your message" required></textarea>
                  </div>
                  <div class="col-12">
                    <button class="rectangle-button button-light" type="submit">send message</button>
                    <p id="contact-feedback" class="form-feedback" role="status" hidden>This is a design demo. Your message has not been sent.</p>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container-fluid echo-container">
        <div class="footer-top">
          <div class="footer-identity">
            <a href="#top" class="wordmark wordmark-footer" aria-label="ECHO — back to top">ECHO</a>
            <div class="social-links" aria-label="Social media — design placeholders">
              <span title="X profile not connected yet" aria-label="X profile not connected yet">𝕏</span>
              <span title="Instagram profile not connected yet" aria-label="Instagram profile not connected yet">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg>
              </span>
              <span title="Video channel not connected yet" aria-label="Video channel not connected yet"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg></span>
            </div>
          </div>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href="#shop">headphones</a>
            <a href="#shop">ear buds</a>
            <a href="#shop">speakers</a>
            <a href="#shop">accessories</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <small>© {year} ECHO. University concept project.</small>
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script>



      const form = document.querySelector<HTMLFormElement>('#contact-form');
      const feedback = document.querySelector<HTMLElement>('#contact-feedback');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (form.reportValidity() && feedback) feedback.hidden = false;
      });
      const searchToggle = document.querySelector<HTMLButtonElement>('#search-toggle');
      const searchPanel = document.querySelector<HTMLElement>('#site-search');
      const searchInput = document.querySelector<HTMLInputElement>('#search-input');
      const searchFeedback = document.querySelector<HTMLElement>('#search-feedback');
      searchToggle?.addEventListener('click', () => {
        if (!searchPanel) return;
        searchPanel.hidden = !searchPanel.hidden;
        searchToggle.setAttribute('aria-expanded', String(!searchPanel.hidden));
        if (!searchPanel.hidden) searchInput?.focus();
      });
      searchInput?.addEventListener('input', () => {
        if (!searchFeedback) return;
        const q = searchInput.value.trim().toLowerCase();
        if (!q) { searchFeedback.textContent = 'Choose a category or search for a product.'; return; }
        const match = [...document.querySelectorAll<HTMLElement>('.bestseller')].find(el => el.textContent?.toLowerCase().includes(q));
        const category = ['headphones', 'earbuds', 'ear buds', 'speakers', 'accessories'].find(c => c.includes(q) || q.includes(c));
        searchFeedback.textContent = match ? 'Matching item in Our bestsellers below.' : category ? 'Explore this category in Shop by categories.' : 'No results in this concept preview.';
      });

      // hide navbar when scroll downward, show when scroll upward or near top of page
      // keep it visible when the search or mobile navigation is open
      const header = document.querySelector<HTMLElement>('.site-header');
      const mobileNavigation = document.querySelector<HTMLElement>('#main-navigation');
      let previousScrollY = Math.max(0, window.scrollY);
      const scrollThreshold = 8;

      window.addEventListener('scroll', () => {
        const currentScrollY = Math.max(0, window.scrollY);
        const delta = currentScrollY - previousScrollY;
        if (Math.abs(delta) < scrollThreshold) return;

        const mobileMenuOpen = mobileNavigation?.classList.contains('show') || mobileNavigation?.classList.contains('collapsing');
        const searchOpen = searchPanel ? !searchPanel.hidden : false;
        const shouldShow = currentScrollY < 80 || delta < 0 || mobileMenuOpen || searchOpen;
        header?.classList.toggle('is-hidden', !shouldShow);
        previousScrollY = currentScrollY;
      }, { passive: true });

      header?.addEventListener('focusin', () => header.classList.remove('is-hidden'));
      mobileNavigation?.addEventListener('show.bs.collapse', () => header?.classList.remove('is-hidden'));

    </script>
  </body>
</html>
