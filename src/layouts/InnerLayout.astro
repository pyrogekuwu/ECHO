---
interface Props {
  title: string;
  description: string;
  ogType?: string;
  schema: Record<string, unknown>;
}
const { title, description, ogType = 'website', schema } = Astro.props;
const year = new Date().getFullYear();
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050506" />
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-lumia.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DotGothic16&family=Genos:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/style.css" rel="stylesheet" />
    <link href="/inner-pages.css" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body id="top" class="inner-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header inner-site-header">
      <nav class="navbar navbar-expand-lg echo-navbar" aria-label="Main navigation">
        <div class="container-fluid nav-inner">
          <a class="wordmark wordmark-nav" href="/" aria-label="ECHO home">ECHO</a>
          <button class="navbar-toggler mobile-menu-toggle" type="button"
            data-bs-toggle="collapse" data-bs-target="#main-navigation"
            aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">
            <span class="menu-lines" aria-hidden="true"><span></span><span></span><span></span></span>
          </button>
          <div class="collapse navbar-collapse nav-collapse" id="main-navigation">
            <ul class="navbar-nav nav-categories">
              <li class="nav-item"><a class="nav-link" aria-current={current.startsWith('/shop') || current.startsWith('/product') ? 'page' : undefined} href="/shop">shop</a></li>
              <li class="nav-item"><a class="nav-link" aria-current={current.startsWith('/journal') ? 'page' : undefined} href="/journal">journal</a></li>
              <li class="nav-item"><a class="nav-link" href="/#about">our world</a></li>
            </ul>
            <div class="nav-icons">
              <a class="inner-nav-contact" aria-current={current === '/contact' ? 'page' : undefined} href="/contact">get in contact <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main id="main" class="inner-main"><slot /></main>

    <footer class="site-footer">
      <div class="container-fluid echo-container">
        <div class="footer-top">
          <div class="footer-identity">
            <a href="/" class="wordmark wordmark-footer" aria-label="ECHO home">ECHO</a>
            <p class="inner-footer-caption">on another frequency.</p>
          </div>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href="/shop">shop</a>
            <a href="/journal">journal</a>
            <a href="/#about">our world</a>
            <a href="/contact">contact</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <small>© {year} ECHO. University concept project. No products are sold on this website.</small>
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
    </footer>
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
  </body>
</html>
