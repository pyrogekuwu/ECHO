---
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import SiteHead from './SiteHead.astro';
import ProductCard from './ProductCard.astro';
import { products, type Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gallery = product.gallery?.length
  ? product.gallery
  : [{ src: product.image, alt: product.alt }];
const variants = product.variants?.length
  ? product.variants
  : [{ label: 'Standard', productId: product.id }];
const reviews = product.reviews ?? [];
const rating = reviews.length
  ? reviews.reduce((sum, review) => sum + review.rating, 0) / reviews.length
  : 0;
const inStock = product.inStock ?? true;
const description = product.description
  ?? `${product.name} from the ECHO ${product.category} collection.`;
const specifications = product.specifications ?? [
  { label: 'Model', value: product.name },
  { label: 'Category', value: product.category },
];
const related = [
  ...products.filter((item) => item.id !== product.id && item.category === product.category),
  ...products.filter((item) => item.category !== product.category),
].slice(0, 3);
const price = new Intl.NumberFormat('en-IE', {
  style: 'currency', currency: 'EUR',
}).format(product.price);
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead />
    <title>{product.name} | ECHO</title>
    <meta name="description" content={description} />
  </head>
  <body id="top" class="product-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />

    <main id="main" class="product-main">
      <div class="container-fluid echo-container">
        <nav class="product-topbar" aria-label="Product navigation">
          <a href={`${base}/${product.category}/`}>
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
            Back to {product.category}
          </a>
          <span>Product</span>
        </nav>

        <div class="product-layout">
          <section
            id="product-gallery"
            class="product-gallery carousel slide"
            data-bs-interval="false"
            role="region"
            aria-roledescription="carousel"
            aria-label={`${product.name} photos`}>


            <div class="product-thumbnails carousel-indicators">
              {gallery.map((photo, index) => (
                <button
                  type="button"
                  data-bs-target="#product-gallery"
                  data-bs-slide-to={index}
                  class:list={['product-thumbnail', { active: index === 0 }]}
                  aria-current={index === 0 ? 'true' : undefined}
                  aria-label={`Show photo ${index + 1}: ${photo.alt}`}
                >
                  <img src={`${base}${photo.src}`} alt="" loading="lazy" />
                </button>
              ))}
            </div>

            <div class="product-gallery-stage">
              <div class="carousel-inner">
                {gallery.map((photo, index) => (
                  <div
                    class:list={['carousel-item', { active: index === 0 }]}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${index + 1} of ${gallery.length}`}
                  >
                    <img
                      src={`${base}${photo.src}`}
                      alt={photo.alt}
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </div>
                ))}
              </div>


              {gallery.length > 1 && (
                <>
                  <button class="product-gallery-arrow product-gallery-prev" type="button"
                    data-bs-target="#product-gallery" data-bs-slide="prev" aria-label="Previous photo">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                  </button>
                  <button class="product-gallery-arrow product-gallery-next" type="button"
                    data-bs-target="#product-gallery" data-bs-slide="next" aria-label="Next photo">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                  </button>
                </>
              )}
            </div>
          </section>

          <section class="product-info" aria-labelledby="product-title">
            <p class="product-eyebrow">{product.category} / {product.sku ?? product.id}</p>
            <h1 id="product-title">{product.name}</h1>

            <div class="product-rating">
              <span aria-hidden="true">
                {Array.from({ length: 5 }, (_, index) => (
                  <i class:list={['bi', rating >= index + 1 ? 'bi-star-fill' : rating >= index + 0.5 ? 'bi-star-half' : 'bi-star']}></i>
                ))}
              </span>
              <span>{reviews.length ? `${rating.toFixed(1)} / 5 (${reviews.length} reviews)` : 'No reviews yet'}</span>
            </div>

            <p class="product-price">{price}</p>
            <p class="product-stock">{inStock ? 'In stock' : 'Out of stock'}</p>
            <p class="product-intro">{description}</p>

            <div class="product-service-notes">
              <span><i class="bi bi-truck" aria-hidden="true"></i> Shipping options at checkout</span>
              <span><i class="bi bi-box-seam" aria-hidden="true"></i> Returns &amp; support</span>
            </div>

            <div class="product-options">
              <div>
                <label class="form-label" for="product-variant">Select variant</label>
                <select class="form-select" id="product-variant" name="variant" disabled={!inStock}>
                  {variants.map((variant) => (
                    <option value={`${base}/product/${variant.productId}/`} selected={variant.productId === product.id}>
                      {variant.label}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label class="form-label" for="product-quantity">Quantity</label>
                <input class="form-control" id="product-quantity" name="quantity"
                  type="number" min="1" step="1" value="1" disabled={!inStock} />
              </div>
            </div>


            <a class:list={['product-add-to-cart rectangle-button button-dark', { 'is-disabled': !inStock }]}
              href={inStock ? `${base}/cart/` : undefined}
              aria-disabled={inStock ? undefined : 'true'} data-product-id={product.id}>
              {inStock ? 'Add to cart' : 'Currently unavailable'}
            </a>


            <div class="accordion accordion-flush product-accordion" id="product-details">
                <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#product-description" aria-expanded="true" aria-controls="product-description">
                    Description
                  </button>
                </h2>
                <div id="product-description" class="accordion-collapse collapse show" data-bs-parent="#product-details">
                  <div class="accordion-body"><p>{product.fullDescription ?? description}</p></div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#product-specifications" aria-expanded="false" aria-controls="product-specifications">
                    Specifications
                  </button>
                </h2>
                <div id="product-specifications" class="accordion-collapse collapse" data-bs-parent="#product-details">
                  <div class="accordion-body">
                    <dl class="product-specifications">
                      {specifications.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
                    </dl>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#product-reviews" aria-expanded="false" aria-controls="product-reviews">
                    Reviews ({reviews.length})
                  </button>
                </h2>
                <div id="product-reviews" class="accordion-collapse collapse" data-bs-parent="#product-details">
                  <div class="accordion-body">
                    {reviews.length ? reviews.map((review) => (
                      <article class="product-review">
                        <h3>{review.author} <span>— {review.rating}/5</span></h3>
                        <p>{review.text}</p>
                      </article>
                    )) : <p>No reviews yet.</p>}
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>



        <section class="product-related" aria-labelledby="related-heading">
          <h2 id="related-heading">You may also like</h2>
          <div class="row g-4">
            {related.map((item) => <div class="col-12 col-sm-6 col-lg-4"><ProductCard product={item} /></div>)}
          </div>
        </section>
      </div>
    </main>

    <Footer />
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script>
  const variant = document.querySelector<HTMLSelectElement>('#product-variant');

  variant?.addEventListener('change', () => {
    if (variant.value) window.location.assign(variant.value);
  });
</script>
</body>
</html>
