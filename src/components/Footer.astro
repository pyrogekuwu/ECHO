---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

---

<footer class="site-footer">
    <div class="container-fluid echo-container">
        <div class="footer-top">
        <div class="footer-identity">
            <a href="#top" class="wordmark wordmark-footer" aria-label="ECHO — back to top">ECHO</a>
            <div class="social-links" aria-label="social media">
            <a href="https://www.instagram.com/">instagram</a>
            <a href="https://x.com/home">twitter</a>
            <a href="https://www.youtube.com/">youtube</a>
        </div>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
        <a href={`${base}/headphones/`}>headphones</a>
        <a href={`${base}/#product-aerospace-black`}>ear buds</a>
        <a href={`${base}/#category-speakers`}>speakers</a>
        <a href={`${base}/#category-accessories`}>accessories</a>
        <a href={`${base}/magazine/`}>magazine</a>
    </nav>
</div>

<div class="footer-bottom">
  <small>© {year} ECHO. Audio brand.</small>

  <div class="footer-legal-links">
    <a href={`${base}/privacy-policy/`}>Privacy policy</a>
    <a href="#top">Back to top ↑</a>
  </div>
</div>
</div>
</footer>