---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

---

<footer class="site-footer">
    <div class="container-fluid echo-container">
        <div class="footer-top">
        <div class="footer-identity">
            <a href="#top" class="wordmark wordmark-footer" aria-label="ECHO — back to top">ECHO</a>
            <div class="social-links" aria-label="Social media — design placeholders">
            <span title="X profile not connected yet" aria-label="X profile not connected yet">𝕏</span>
            <span title="Instagram profile not connected yet" aria-label="Instagram profile not connected yet">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg>
            </span>
            <span title="Video channel not connected yet" aria-label="Video channel not connected yet"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg></span>
        </div>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
        <a href={`${base}/headphones/`}>headphones</a>
        <a href={`${base}/#product-aerospace-black`}>ear buds</a>
        <a href={`${base}/#category-speakers`}>speakers</a>
        <a href={`${base}/#category-accessories`}>accessories</a>
    </nav>
</div>

<div class="footer-bottom">
    <small>© {year} ECHO. University concept project.</small>
    <a href="#top">Back to top ↑</a>
</div>
</div>
</footer>