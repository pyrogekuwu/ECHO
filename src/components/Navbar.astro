---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

---

    <header class="site-header">
        <nav class="navbar navbar-expand-xxl echo-navbar" aria-label="Main navigation">
            <div class="container-fluid nav-inner">
                <a class="wordmark wordmark-nav" href={`${base}/`} aria-label="ECHO home">ECHO</a>
                <button class="navbar-toggler mobile-menu-toggle" type="button" data-bs-toggle="collapse" 
                        data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" 
                        aria-label="Toggle navigation">
                        <span class="menu-lines" aria-hidden="true"><span></span><span></span><span></span></span>
                    </button>
                    
                    <div class="collapse navbar-collapse nav-collapse" id="main-navigation">
                        <ul class="navbar-nav nav-categories">
                            <li class="nav-item"><a class="nav-link" href={`${base}/headphones/`}>headphones</a></li>
                            <li class="nav-item"><a class="nav-link" href={`${base}/#product-aerospace-black`}>ear buds</a></li>
                            <li class="nav-item"><a class="nav-link" href={`${base}/#category-speakers`}>speakers</a></li>
                            <li class="nav-item"><a class="nav-link" href={`${base}/#category-accessories`}>accessories</a></li>
                            <li class="nav-item"><span class="nav-link disabled" aria-disabled="true" title="Magazine — coming soon">magazine</span></li>
                        </ul>
                        <div class="nav-icons">
                            <button type="button" class="icon-button" id="search-toggle" aria-label="Search ECHO" 
                            aria-expanded="false" aria-controls="site-search">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m15.4 15.4 5 5"/></svg>
                        </button>
                        <button type="button" class="icon-button" disabled aria-label="My account — coming soon" title="My account — coming soon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.3" r="3.1"/><path d="M4.8 21v-2.4a7.2 7.2 0 0 1 14.4 0V21z"/></svg>
                        </button>
                        <a class="icon-button" href={`${base}/#contact`} aria-label="Contact us">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3z"/><path d="m3 6 9 7 9-7M3 18l7-6M21 18l-7-6"/></svg>
                        </a>
                        <button type="button" class="icon-button" disabled aria-label="Cart — coming soon" title="Cart — coming soon">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 8h15l-1 12h-13z"/><path d="M9 9V6.7a3 3 0 0 1 6 0V9"/></svg>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
        <div class="search-panel" id="site-search" hidden>
            <label for="search-input">Search the collection</label>
            <input id="search-input" type="search" placeholder="Try ‘headphones’" autocomplete="off" aria-describedby="search-feedback" />
            <p id="search-feedback" role="status">Choose a category or search for a product.</p>
        </div>
    </header>
<script>
      const searchToggle = document.querySelector<HTMLButtonElement>('#search-toggle');
      const searchPanel = document.querySelector<HTMLElement>('#site-search');
      const searchInput = document.querySelector<HTMLInputElement>('#search-input');
      const searchFeedback = document.querySelector<HTMLElement>('#search-feedback');
      searchToggle?.addEventListener('click', () => {
        if (!searchPanel) return;
        searchPanel.hidden = !searchPanel.hidden;
        searchToggle.setAttribute('aria-expanded', String(!searchPanel.hidden));
        if (!searchPanel.hidden) searchInput?.focus();
      });
      searchInput?.addEventListener('input', () => {
        if (!searchFeedback) return;
        const q = searchInput.value.trim().toLowerCase();
        if (!q) { searchFeedback.textContent = 'Choose a category or search for a product.'; return; }
        const match = [...document.querySelectorAll<HTMLElement>('.bestseller, .category-main article')].find(el => el.textContent?.toLowerCase().includes(q));
        const category = ['headphones', 'earbuds', 'ear buds', 'speakers', 'accessories'].find(c => c.includes(q) || q.includes(c));
        searchFeedback.textContent = match ? 'Matching item in the collection below.' : category ? 'Explore this category in Shop by categories.' : 'No results in this concept preview.';
      });

      // hide navbar when scroll downward, show when scroll upward or near top of page
      // keep it visible when the search or mobile navigation is open
      const header = document.querySelector<HTMLElement>('.site-header');
      const mobileNavigation = document.querySelector<HTMLElement>('#main-navigation');
      let previousScrollY = Math.max(0, window.scrollY);
      const scrollThreshold = 8;

      window.addEventListener('scroll', () => {
        const currentScrollY = Math.max(0, window.scrollY);
        const delta = currentScrollY - previousScrollY;
        if (Math.abs(delta) < scrollThreshold) return;

        const mobileMenuOpen = mobileNavigation?.classList.contains('show') || mobileNavigation?.classList.contains('collapsing');
        const searchOpen = searchPanel ? !searchPanel.hidden : false;
        const shouldShow = currentScrollY < 80 || delta < 0 || mobileMenuOpen || searchOpen;
        header?.classList.toggle('is-hidden', !shouldShow);
        previousScrollY = currentScrollY;
      }, { passive: true });

      header?.addEventListener('focusin', () => header.classList.remove('is-hidden'));
      mobileNavigation?.addEventListener('show.bs.collapse', () => header?.classList.remove('is-hidden'));

</script>
