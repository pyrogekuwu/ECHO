
---
import Navbar from '../components/Navbar.astro';
interface Product {
  name: string;
  price: string;
  image: string;
  alt: string;
}
interface Props {
  title: string;
  products: Product[];
}

const { title, products } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{title} | ECHO</title>
    <meta
      name="description"
      content={`Explore ECHO ${title} collection.`}
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DotGothic16&family=Genos:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- ECHO CSS -->
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <Navbar />

    <main id="main" class="bg-light text-dark min-vh-100 py-5">
      <section class="container">
        <h1 class="mb-5">{title}</h1>

        <div class="row g-4 justify-content-center">
          {products.map((product) => (
            <div class="col-12 col-sm-6 col-lg-4">
              <article class="text-center">

                <img
                  src={product.image}
                  alt={product.alt}
                  class="img-fluid"
                  loading="lazy"
                />

                <h2 class="fs-6 mt-3">{product.name}</h2>
                <p>{product.price}</p>

              </article>
            </div>
          ))}
        </div>
      </section>
    </main>

    <!-- Bootstrap 5 JS -->
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
    ></script>
  </body>
</html>
