---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Product {
  id: string;
  name: string;
  price: string;
  image: string;
  alt: string;
}
interface Props {
  title: string;
  products: Product[];
}

const { title, products } = Astro.props;
---



<!doctype html>
<html lang="en">

  <head>
    <SiteHead />
    <title>{title} | ECHO</title>
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <Navbar />

    <main id="main" class="category-main min-vh-100 py-5">
      <section class="container">
        <h1 class="category-title-main">{title}</h1>

        <div class="row g-4 mt-5 justify-content-center">
          {products.map((product) => (
            <div class="col-12 col-sm-6 col-lg-4">
              <article class="text-center" id={product.id}>

                <img src={`${base}${product.image}`} alt={product.alt} class="img-fluid" loading="lazy" />

                <h2 class="fs-6 mt-3">{product.name}</h2>
                <p>{product.price}</p>

              </article>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Footer />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      defer
    ></script>
  </body>
</html>
